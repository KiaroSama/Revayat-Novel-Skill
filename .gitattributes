# Normalise every text file to LF in the repository.
* text=auto eol=lf

*.rs   text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.tsv  text eol=lf

# Never let a filter touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.docx  binary
*.epub  binary
*.zip   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
